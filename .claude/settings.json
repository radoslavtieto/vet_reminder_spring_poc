{
  "permissions": {
    "allow": [
      "Bash(./mvnw -B:*)",
      "Bash(.\\mvnw.cmd -B:*)",
      "Bash(docker compose -f infra/:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(azd up:*)",
      "Bash(azd provision:*)",
      "Bash(azd deploy:*)",
      "Bash(az deployment:*)",
      "Bash(az group create:*)",
      "Bash(terraform apply:*)"
    ]
  }
}
